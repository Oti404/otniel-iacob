{
  "compilerOptions": {
    // File Layout — rootDir must be set to monorepo root because backend
    // imports from @monorepo/database (../database), which extends the
    // common source tree above the backend directory.
    "rootDir": "..",
    "outDir": "./dist",

    "module": "commonjs",
    "target": "es2022",
    "types": [],

    "sourceMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
