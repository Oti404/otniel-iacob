{
  "name": "portofoliu-personal",
  "version": "0.0.0",
  "scripts": {
  "ng": "ng",
  "start": "ng serve",
  "build": "ng build",
  "watch": "ng build --watch --configuration development",
  "test": "ng test",

  "// --- COMENZI DEPLOY ---": "",
  "predeploy": "ng build --base-href / && echo otniel-iacob.website > dist/portofoliu-personal/browser/CNAME",
  "deploy-gh": "npx gh-pages -d dist/portofoliu-personal/browser",
  "full-deploy": "npm run predeploy && npm run deploy-gh"
},
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@monorepo/shared": "*"
  },
  "devDependencies": {
    "@angular/build": "^21.2.15",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.17",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
