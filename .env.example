# ─── DATABASE ────────────────────────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# Local dev: points to localhost:5433 (mapped Docker port)
# Production: set automatically via docker-compose.prod.yml (postgres service)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5433/your_db_name

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Min 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
ADMIN_PASSWORD=your_admin_password

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# ─── INTERNAL API ────────────────────────────────────────────────────────────
# Used by n8n webhooks to authenticate internal calls
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=your_internal_api_key

# ─── N8N ─────────────────────────────────────────────────────────────────────
n8n_email=your_n8n_email
N8N_PASSWORD=your_n8n_password
n8n_key=your_n8n_encryption_key

# Public URL for n8n webhooks (used by n8n itself for webhook registration)
N8N_WEBHOOK_URL=http://localhost:5678/

# Webhook URL for the AI chat feature (copy from n8n workflow settings)
N8N_CHAT_WEBHOOK_URL=http://n8n:5678/webhook/your-webhook-id/chat

# ─── EXTERNAL APIs ───────────────────────────────────────────────────────────
# Google Gemini API key (used in n8n workflow for AI assistant)
PORTFOLIO_N8N_PROJECT_INTAKE=your_google_gemini_api_key
