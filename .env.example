# ─── DATABASE ────────────────────────────────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# Local dev: points to localhost:5433 (mapped Docker port)
# Production: set automatically via docker-compose.prod.yml (postgres service)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5433/your_db_name

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Min 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
# Separate secret for subscriber (Google OAuth) tokens — must differ from JWT_SECRET
# so a subscriber token can never be replayed as an admin token. Generate with: openssl rand -hex 32
JWT_SUBSCRIBER_SECRET=your_jwt_subscriber_secret_min_32_chars
ADMIN_PASSWORD=your_admin_password

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

